---
import '../styles/global.css';
import PhoneBanner from '../components/PhoneBanner.astro';
import Footer from '../components/Footer.astro';
import business from '../data/business.json';

interface Props {
  title: string;
  description?: string;
  /** Page-specific JSON-LD node(s) to add to the sitewide @graph (Restaurant + WebSite). */
  jsonLd?: object | object[];
}

const {
  title,
  description = `${business.name} — a family-run Mexican restaurant in ${business.addressLocality}, ${business.addressRegion}, serving authentic recipes since ${business.foundingYear}.`,
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site?.href ?? 'https://localhost:4321';

/** Safe access to the current page path — Astro.url throws when site is not configured. */
let currentPage = '/';
try {
  currentPage = Astro.url?.pathname ?? '/';
} catch {
  // Astro.url throws in static mode without a site configured — use fallback
}

const canonical = new URL(currentPage, siteOrigin).href;
const ogImage = new URL('/og-image.jpg', siteOrigin).href;

const restaurantSchema = {
  '@type': 'Restaurant',
  '@id': `${siteOrigin}#restaurant`,
  name: business.name,
  legalName: business.legalName,
  url: siteOrigin,
  image: ogImage,
  telephone: business.telephone,
  priceRange: business.priceRange,
  servesCuisine: business.servesCuisine,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.streetAddress,
    addressLocality: business.addressLocality,
    addressRegion: business.addressRegion,
    postalCode: business.postalCode,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  openingHoursSpecification: business.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  hasMenu: new URL('/menu/', siteOrigin).href,
  ...(business.sameAs.length > 0 && { sameAs: business.sameAs }),
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteOrigin}#website`,
  name: business.name,
  url: siteOrigin,
};

const graph = [restaurantSchema, websiteSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!DOCTYPE html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preconnect to Google Fonts for parallel loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- JSON-LD structured data: Restaurant + WebSite (+ page-specific nodes) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': graph,
    })} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-gold focus:text-charcoal focus:font-medium"
    >
      Skip to main content
    </a>

    <PhoneBanner />

    <header class="sticky top-12 md:top-9 z-40">
      <slot name="header" />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <Footer />
    </footer>
  </body>
</html>