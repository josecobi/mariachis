      <!-- Map Section -->
      <div class="mt-12 animate-load animate-load-delay-3">
        <h2 class="text-3xl font-heading text-charcoal mb-6 text-center">Find Us</h2>
        <div class="bg-cream-dark rounded-lg overflow-hidden h-96">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3084.8149270567656!2d-76.60919!3d39.2895!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89b7c8f4d4d4d4d5%3A0x5d5d5d5d5d5d5d5d!2s2227%20Eastern%20Ave%2C%20Baltimore%2C%20MD%2021231!5e0!3m2!1sen!2sus!4v1234567890"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
