---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import business from '../data/business.json';
---

<BaseLayout
  title={`About Us | ${business.name}, ${business.addressLocality}`}
  description={`The story behind ${business.name} — family recipes, the people in the kitchen, and what makes our ${business.addressLocality} restaurant a local favorite.`}
>
  <Nav slot="header" client:load currentPath="/about" />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="space-y-16">
      <!-- Header -->
      <div class="text-center space-y-4 animate-load">
        <span class="inline-block text-gold text-xs tracking-[0.3em] uppercase font-medium">
          {business.addressLocality} · Family Owned · Since {business.foundingYear}
        </span>
        <h1 class="text-5xl sm:text-6xl font-heading text-charcoal">About Los Mariachis</h1>
        <div class="flex items-center justify-center gap-4 py-1">
          <span class="h-px w-12 bg-gold opacity-40" />
          <span class="w-2 h-2 rounded-full bg-gold opacity-60" />
          <span class="h-px w-12 bg-gold opacity-40" />
        </div>
        <p class="text-lg text-warm-gray max-w-2xl mx-auto">
          We're a small, family-run kitchen — not a chain, not a concept. Just recipes we grew up with and a table we're glad to share.
        </p>
      </div>

      <!-- Our Story -->
      <article class="space-y-6 animate-load animate-load-delay-1">
        <div>
          <h2 class="text-3xl font-heading text-charcoal mb-4">Our Story</h2>
          <p class="text-warm-gray leading-relaxed mb-4">
            Los Mariachis started as a small family kitchen, not a business plan. Since {business.foundingYear}, the same recipes have been simmering on our stove — the ones we grew up eating, made the way they've always been made, one dish at a time.
          </p>
          <p class="text-warm-gray leading-relaxed">
            The name comes from something bigger than food: the spirit of celebration and togetherness that runs through every gathering in Mexican culture. Pull up a chair, and for a little while, you're part of that too.
          </p>
        </div>
      </article>

      <!-- Pull quote -->
      <div class="text-center py-4 animate-reveal">
        <p class="font-heading italic text-2xl sm:text-3xl text-charcoal leading-snug max-w-2xl mx-auto">
          "This isn't a restaurant we run. It's a table we've always kept open."
        </p>
        <div class="flex items-center justify-center gap-4 mt-6">
          <span class="h-px w-12 bg-gold opacity-40" />
          <span class="w-2 h-2 rounded-full bg-gold opacity-60" />
          <span class="h-px w-12 bg-gold opacity-40" />
        </div>
      </div>

      <!-- Our Philosophy -->
      <article class="space-y-6 animate-load animate-load-delay-2">
        <div>
          <h2 class="text-3xl font-heading text-charcoal mb-4">Our Philosophy</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="space-y-3">
              <h3 class="text-xl font-heading text-gold">Family Recipes</h3>
              <p class="text-warm-gray text-sm leading-relaxed">
                Every recipe on our menu has been in the family longer than the restaurant has. We haven't changed that, and we don't plan to.
              </p>
            </div>
            <div class="space-y-3">
              <h3 class="text-xl font-heading text-gold">Made by Hand</h3>
              <p class="text-warm-gray text-sm leading-relaxed">
                Tortillas pressed, salsas blended, everything made fresh each morning — the way a home kitchen does it, just for more people.
              </p>
            </div>
            <div class="space-y-3">
              <h3 class="text-xl font-heading text-gold">A Seat at Our Table</h3>
              <p class="text-warm-gray text-sm leading-relaxed">
                We're small enough to remember your name and your order. That's not a slogan — it's just how a family restaurant works.
              </p>
            </div>
          </div>
        </div>
      </article>

      <!-- Our Kitchen Family -->
      <article class="space-y-6 animate-load animate-load-delay-3">
        <div>
          <h2 class="text-3xl font-heading text-charcoal mb-4">Our Kitchen Family</h2>
          <p class="text-warm-gray leading-relaxed mb-4">
            There's no corporate office behind Los Mariachis — just people who show up every day because this place means something to them. Many of us are related; all of us treat the kitchen like it's ours, because it is.
          </p>
          <p class="text-warm-gray leading-relaxed">
            We've kept things simple on purpose: good ingredients, recipes worth protecting, and a dining room that feels like somebody's home. In a lot of ways, it still is.
          </p>
        </div>
      </article>

      <!-- CTA -->
      <div class="text-center pt-8 animate-reveal">
        <a
          href="/menu/"
          class="group relative inline-flex items-center gap-2 px-8 py-4 bg-gold text-charcoal font-medium text-sm tracking-wide overflow-hidden transition-[var(--transition-smooth)] hover:bg-gold-light active:scale-[0.98]"
        >
          <span class="relative z-10">Explore Our Menu</span>
          <svg
            class="relative z-10 w-4 h-4 transition-transform group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H9" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
