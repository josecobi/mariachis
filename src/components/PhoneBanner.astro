---
const phone = '(410) 276-5757';
const phoneLink = 'tel:+1-410-276-5757';
---

<div class="bg-gold text-charcoal sticky top-0 z-30 shadow-soft">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Mobile: whole bar is one prominent tap-to-call target -->
    <a
      href={phoneLink}
      aria-label={`Call us to order: ${phone}`}
      class="md:hidden flex items-center justify-center gap-2 h-12 font-semibold active:bg-gold-dark transition-colors"
    >
      <svg class="w-5 h-5 flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="text-sm">Call to order:</span>
      <span class="text-base">{phone}</span>
    </a>

    <!-- Desktop: understated text link, still tel: but not a CTA -->
    <a
      href={phoneLink}
      class="hidden md:flex items-center justify-center gap-2 h-9 text-sm text-charcoal/70 hover:text-charcoal transition-colors"
    >
      <svg class="w-4 h-4 flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span>Call us to order: <span class="font-medium">{phone}</span></span>
    </a>
  </div>
</div>
