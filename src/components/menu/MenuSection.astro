---
import { Image } from 'astro:assets';
import MenuItem from './MenuItem.astro';

interface MenuItem {
  name: string;
  description?: string;
  price: number;
  options?: string;
  variants?: { label: string; price: number }[];
  tags?: ('spicy' | 'veggie' | 'house-special' | 'kids')[];
  image?: string;
  imageAlt?: string;
}

interface Props {
  id: string;
  index: number;
  name: string;
  note?: string;
  image?: string;
  imageAlt?: string;
  items: MenuItem[];
}

const { id, index, name, note, image, imageAlt, items } = Astro.props;

let imageImport: { default: ImageMetadata } | undefined;
if (image) {
  const images = import.meta.glob('../../assets/*.{jpg,jpeg,png,webp}', {
    eager: true,
    import: 'default',
  }) as Record<string, ImageMetadata>;

  const imagePath = `../../assets/${image}`;
  if (!images[imagePath]) {
    throw new Error(`Image not found: ${image} (tried ${imagePath})`);
  }
  imageImport = { default: images[imagePath] };
}
---

<section
  id={id}
  class="scroll-mt-20 py-14 md:py-20 border-b border-charcoal/10 last:border-b-0 animate-reveal"
  aria-labelledby={`${id}-heading`}
>
  <header class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end mb-10">
    <div>
      <span class="block text-terracotta text-xs tracking-[0.3em] font-medium mb-3">
        {String(index).padStart(2, '0')}
      </span>
      <h2 id={`${id}-heading`} class="font-heading text-3xl md:text-4xl text-charcoal leading-tight">
        {name}
      </h2>
      {note && <p class="mt-3 text-sm italic text-warm-gray max-w-prose leading-relaxed">{note}</p>}
    </div>
    {
      imageImport && (
        <Image
          src={imageImport.default}
          alt={imageAlt || ''}
          widths={[320, 448, 896]}
          sizes="(min-width: 768px) 224px, 100vw"
          format="webp"
          quality={75}
          loading="lazy"
          decoding="async"
          class="w-full md:w-56 aspect-[4/3] object-cover rounded-sm"
        />
      )
    }
  </header>
  <ul class="grid md:grid-cols-2 gap-x-12 gap-y-7" role="list">
    {items.map((item) => <MenuItem {...item} />)}
  </ul>
</section>
